diff --git a/.github/workflows/dependabot-auto-merge.yml b/.github/workflows/dependabot-auto-merge.yml
index 2baa315..ab9ae17 100644
--- a/.github/workflows/dependabot-auto-merge.yml
+++ b/.github/workflows/dependabot-auto-merge.yml
@@ -1,6 +1,9 @@
 name: Dependabot auto-merge
 
-on: pull_request
+# pull_request_target + RELEASE_TOKEN so the merge commit is attributed to a
+# real user token and triggers Auto Tag / CI on main (GITHUB_TOKEN merges do not).
+
+on: pull_request_target
 
 permissions:
   contents: write
@@ -18,11 +21,10 @@ jobs:
           github-token: ${{ secrets.GITHUB_TOKEN }}
 
       - name: Enable auto-merge for non-major updates
-        if: >
-          steps.metadata.outputs.dependency-group != 'bun-major' &&
-          steps.metadata.outputs.dependency-group != 'cargo-major' &&
-          steps.metadata.outputs.update-type != 'version-update:semver-major'
+        # Gate on semver only — Dependabot may put patch bumps in cargo-major
+        # when the group is defined by update-type major patterns alone.
+        if: steps.metadata.outputs.update-type != 'version-update:semver-major'
         run: gh pr merge --auto --squash "$PR_URL"
         env:
           PR_URL: ${{ github.event.pull_request.html_url }}
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index fda0835..c042ae3 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -45,14 +45,18 @@ jobs:
             wasm-pack build --target web --release
           fi
 
+      # Do not set setup-node registry-url: it writes an .npmrc with
+      # _authToken=${NODE_AUTH_TOKEN}, which short-circuits OIDC trusted publishing
+      # and surfaces a misleading E404 from the registry.
       - uses: actions/setup-node@v7
         with:
           node-version: "24.x"
-          registry-url: "https://registry.npmjs.org"
 
       - name: Ensure modern npm for OIDC trusted publishing
         run: npm install -g npm@latest
 
       - name: Publish pkg to npm
         working-directory: pkg
-        run: npm publish --access public --provenance --ignore-scripts
+        env:
+          NODE_AUTH_TOKEN: ""
+        run: npm publish --access public --provenance --ignore-scripts --registry=https://registry.npmjs.org
diff --git a/.github/workflows/supervisor.yml b/.github/workflows/supervisor.yml
index 8c48c42..bafd0d7 100644
--- a/.github/workflows/supervisor.yml
+++ b/.github/workflows/supervisor.yml
@@ -11,6 +11,8 @@ permissions:
   issues: write
   checks: read
   actions: read
+  # Required so the injected GITHUB_TOKEN can push .github/workflows/*.
+  workflows: write
 
 concurrency:
   group: weekly-unstick
@@ -34,6 +36,9 @@ jobs:
         env:
           CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
           GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
+          # workflows: write. Checkout uses RELEASE_TOKEN, which cannot push
+          # workflow files; point git at GITHUB_TOKEN for those pushes.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           agent -p "$(cat <<'PROMPT'
           You are the weekly unsticker for this repository.
@@ -49,6 +54,11 @@ jobs:
           - Do not weaken branch protection or disable required checks.
           - Open or update a PR if direct push is blocked; otherwise push to
             the default branch only when safe and hooks/CI would pass.
+          - GH_TOKEN is RELEASE_TOKEN (can push non-workflow commits to main,
+            cannot edit .github/workflows or open PRs). For workflow-file
+            pushes and pull requests, use GITHUB_TOKEN (workflows: write).
+            Checkout's remote is RELEASE_TOKEN, so retarget git at
+            GITHUB_TOKEN before those pushes.
           - Summarize what was stuck and what you did at the end.
           PROMPT
           )" --model auto --force --trust --sandbox disabled
diff --git a/.github/workflows/update-outdated-prs.yml b/.github/workflows/update-outdated-prs.yml
index 7df7b68..532bb7b 100644
--- a/.github/workflows/update-outdated-prs.yml
+++ b/.github/workflows/update-outdated-prs.yml
@@ -17,7 +17,8 @@ jobs:
     steps:
       - name: Update out-of-date PR branches
         env:
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          # RELEASE_TOKEN (push access) so Dependabot honors @dependabot rebase.
+          GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
         run: |
           set -euo pipefail
 
